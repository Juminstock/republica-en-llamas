# Network: monadTestnet | soneiumMinato
VITE_NETWORK=monadTestnet
# Privy app id (dashboard.privy.io). Public by design.
VITE_PRIVY_APP_ID=
# Pimlico API key. Restrict it to your domains in the Pimlico dashboard.
VITE_PIMLICO_API_KEY=
# Optional Pimlico sponsorship policy id (sp_...)
VITE_PIMLICO_SPONSORSHIP_POLICY_ID=

# ---- Server only (Vercel Functions). Never prefix these with VITE_. ----
# Private key of the game server signer. Its address is SERVER_SIGNER at deploy time.
SERVER_SIGNER_PRIVATE_KEY=
# Vercel Blob token (created when you connect a Blob store to the project).
BLOB_READ_WRITE_TOKEN=
# Optional RPC override for server reads.
RPC_URL=
